        ]
    },

    "MirrorRewardCardContinueChoosing": {
        "doc": "如果弹出「继续选择」按钮，点击继续",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/get_reward_card/continue_choosing_assets.png",
