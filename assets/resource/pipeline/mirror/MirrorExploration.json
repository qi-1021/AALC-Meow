{
    "MirrorDungeonExploration": {
        "doc": "镜牢探索主循环：循环检测当前状态并分发到对应处理节点",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/legend_assets.png",
            "threshold": 0.70
        },
        "action": "DoNothing",
        "next": [
            "ClickEnterNode",
            "MirrorHandleThemePackFeature",
            "MirrorHandleRewardCard",
            "MirrorHandleEgoGiftCard",
            "MirrorHandleEgoGiftBox",
            "MirrorEgoGiftGetConfirm2",
            "MirrorHandleShop",
            "MirrorHandleEvent",
            "ClaimMirrorReward",
            "MirrorDungeonExploration"
        ]
    },

    "ClickEnterNode": {
        "doc": "在地图上点击「进入」按钮前往下一节点",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/enter_assets.png",
            "threshold": 0.72
        },
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "BattleAutoCombat",
            "MirrorDungeonExploration"
        ]
    },

    "MirrorHandleThemePackFeature": {
        "doc": "检测到楼层主题包选择页面（feature_theme_pack_assets）",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/theme_pack/feature_theme_pack_assets.png",
            "threshold": 0.72
        },
        "action": "DoNothing",
        "next": [
            "MirrorPickThemePackConfirm",
            "MirrorRefreshThemePack"
        ]
    },

    "MirrorPickThemePackConfirm": {
        "doc": "选中卡包并下拉/点击确认（默认点击中间偏左位置的主题卡包）",
        "action": {
            "type": "Click",
            "target": [500, 540]
        },
        "post_delay": 1500,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorRefreshThemePack": {
        "doc": "若卡包不理想，点击刷新主题包按钮",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/theme_pack/refresh_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000,
        "next": ["MirrorPickThemePackConfirm"]
    },

    "MirrorHandleRewardCard": {
        "doc": "检测到奖励卡选择界面（encounter reward card）",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/get_reward_card/get_reward_card_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "DoNothing",
        "next": [
            "MirrorRewardCardSelectEGO",
            "MirrorRewardCardSelectFirst"
        ]
    },

    "MirrorRewardCardSelectEGO": {
        "doc": "优先选择含 EGO 的奖励卡",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/get_reward_card/gain_ego.png",
            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 500,
        "next": ["ClickRewardCardConfirm"]
    },

    "MirrorRewardCardSelectFirst": {
        "doc": "无偏好时选择第一张奖励卡（最左）",
        "action": {
            "type": "Click",
            "target": [400, 540]
        },
        "post_delay": 500,
        "next": ["ClickRewardCardConfirm"]
    },

    "ClickRewardCardConfirm": {
        "doc": "点击奖励卡确认按钮",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/get_reward_card/get_reward_card_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000,
        "next": ["MirrorDungeonExploration"]
    },

