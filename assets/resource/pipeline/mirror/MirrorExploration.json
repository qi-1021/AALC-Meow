{
    "MirrorDungeonExploration": {
        "doc": "镜牢探索主循环：循环检测当前状态并分发到对应处理节点",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/legend_assets.png",
            "threshold": 0.72
        },
        "action": "DoNothing",
        "next": [
            "ClickEnterNode",
            "MirrorHandleThemePack",
            "MirrorHandleRewardCard",
            "MirrorHandleEgoGiftCard",
            "MirrorHandleEgoGiftBox",
            "MirrorEgoGiftGetConfirm2",
            "MirrorHandleShop",
            "MirrorHandleEvent",
            "ClaimMirrorReward",
            "MirrorDungeonExploration"
        ]
    },

    "ClickEnterNode": {
        "doc": "在地图上点击「进入」按钮前往下一节点",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/enter_assets.png",
            "threshold": 0.72
        },
        "action": "Click",
        "post_delay": 1500,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorHandleThemePack": {
        "doc": "检测到主题包选择界面（楼层卡包选择），选择与体系匹配的卡包",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/hard_battle.png",
            "threshold": 0.72
        },
        "action": "DoNothing",
        "next": [
            "MirrorThemePackConfirm",
            "MirrorDungeonExploration"
        ]
    },

    "MirrorThemePackConfirm": {
        "doc": "选中卡包后确认（拖拽到卡包上）",
        "action": {
            "type": "Click",
            "target": [400, 540]
        },
        "post_delay": 1200,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorHandleRewardCard": {
        "doc": "检测到奖励卡选择界面（encounter reward card），选择对应奖励卡",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/get_reward_card/get_reward_card_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "DoNothing",
        "next": [
            "MirrorRewardCardSelectEGO",
            "MirrorRewardCardSelectFirst"
        ]
    },

    "MirrorRewardCardSelectEGO": {
        "doc": "优先选择含 EGO 的奖励卡",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/get_reward_card/gain_ego.png",
            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 500,
        "next": ["ClickRewardCardConfirm"]
    },

    "MirrorRewardCardSelectFirst": {
        "doc": "无偏好时选择第一张奖励卡（最左）",
        "action": {
            "type": "Click",
            "target": [400, 540]
        },
        "post_delay": 500,
        "next": ["ClickRewardCardConfirm"]
    },

    "ClickRewardCardConfirm": {
        "doc": "点击奖励卡确认按钮",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/get_reward_card/get_reward_card_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorHandleEgoGiftCard": {
        "doc": "检测到 EGO 饰品卡选择界面，按 MirrorTheme 选体系饰品或第一个",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/acquire_ego_gift_card.png",
            "threshold": 0.75
        },
        "action": "DoNothing",
        "next": [
            "MirrorEgoGiftPickBleed",
            "MirrorEgoGiftPickTremor",
            "MirrorEgoGiftPickRupture",
            "MirrorEgoGiftPickSinking",
            "MirrorEgoGiftPickCharge",
            "MirrorEgoGiftPickPoise",
            "MirrorEgoGiftPickBurn",
            "MirrorEgoGiftPickFirst"
        ]
    },

