    },
    "MirrorEgoGiftPickBurn": {
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/acquire_ego_gift/burn.png",
            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 600,
