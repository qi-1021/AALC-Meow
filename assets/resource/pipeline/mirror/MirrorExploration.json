            "type": "TemplateMatch",
            "template": "mirror/get_reward_card/gain_ego_resource.png",
            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 500,
        "next": ["ClickRewardCardConfirm"]
    },

    "MirrorRewardCardSelectFirst": {
        "doc": "无匹配偏好时选择第一张奖励卡（最左侧固定位置）",
        "action": {
            "type": "Click",
            "target": [400, 540]
        },
        "post_delay": 500,
        "next": ["ClickRewardCardConfirm"]
    },

    "ClickRewardCardConfirm": {
        "doc": "点击奖励卡确认按钮",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/get_reward_card/get_reward_card_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000,
        "next": [
            "MirrorRewardCardContinueChoosing",
