            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 600,
        "next": ["MirrorHandleEgoGiftBox"]
    },
    "MirrorEgoGiftPickPoise": {
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/acquire_ego_gift/poise.png",
            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 600,
