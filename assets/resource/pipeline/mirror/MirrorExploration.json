{
    "MirrorDungeonExploration": {
        "doc": "镜牢探索主循环：循环检测当前状态并分发到对应处理节点",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/road_in_mir/legend_assets.png",
            "threshold": 0.70
        },
        "action": "DoNothing",
        "next": [
            "MirrorFloor3ExitAction",
            "ClickEnterNode",
            "MirrorHandleThemePackFeature",
            "MirrorHandleRewardCard",
            "MirrorHandleEgoGiftCard",
            "MirrorHandleEgoGiftBox",
            "MirrorEgoGiftGetConfirm2",
            "MirrorHandleShop",
            "MirrorHandleEvent",
            "ClaimMirrorReward",
            "MirrorDungeonExploration"
        ]
    },

    "MirrorFloor3ExitAction": {
        "doc": "只打三层速刷退出逻辑：由 Floor3Exit option 激活后，在地图界面点击右上角设置图标",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/road_in_mir/setting_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_wait_freezes": 800,
        "next": [
            "MirrorClickForfeitButton"
        ]
    },

    "MirrorClickForfeitButton": {
        "doc": "在设置菜单中点击「放弃/认输」按钮",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/road_in_mir/forfeit_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_wait_freezes": 800,
        "next": [
            "MirrorConfirmForfeitExit"
        ]
    },

    "MirrorConfirmForfeitExit": {
        "doc": "二次确认放弃，直接进入奖励结算页",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/road_in_mir/towindow&forfeit_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_wait_freezes": 1500,
        "next": [
            "ClaimMirrorReward"
        ]
    },

    "ClickEnterNode": {
        "doc": "在地图上点击「进入」按钮前往下一节点",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/road_in_mir/enter_assets.png",
            "threshold": 0.72
        },
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "BattleAutoCombat",
            "MirrorDungeonExploration"
        ]
    },

    "MirrorHandleThemePackFeature": {
        "doc": "检测到楼层主题包选择页面（feature_theme_pack_assets）",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/theme_pack/feature_theme_pack_assets.png",
            "threshold": 0.72
        },
        "action": "DoNothing",
        "next": [
            "MirrorPickThemePackConfirm",
            "MirrorRefreshThemePack"
        ]
    },

    "MirrorPickThemePackConfirm": {
        "doc": "选中卡包并点击确认（默认点击中间偏左位置的主题卡包）",
        "action": {
            "type": "Click",
            "target": [500, 540]
        },
        "post_delay": 1500,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorRefreshThemePack": {
        "doc": "若卡包不理想，点击刷新主题包按钮",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/theme_pack/refresh_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000,
        "next": ["MirrorPickThemePackConfirm"]
    },

    "MirrorHandleRewardCard": {
        "doc": "检测到奖励卡选择界面（encounter reward card）",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/get_reward_card/get_reward_card_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "DoNothing",
        "next": [
            "MirrorRewardCardSelectStarlight",
            "MirrorRewardCardSelectEGO",
            "MirrorRewardCardSelectCost",
            "MirrorRewardCardSelectCostAndEGO",
            "MirrorRewardCardSelectEGOResource",
            "MirrorRewardCardSelectFirst"
        ]
    },

    "MirrorRewardCardSelectStarlight": {
        "doc": "优先选择星光奖励卡",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/get_reward_card/gain_starlight.png",
            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 500,
        "next": ["ClickRewardCardConfirm"]
    },

    "MirrorRewardCardSelectEGO": {
        "doc": "选择含 EGO 饰品的奖励卡",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/get_reward_card/gain_ego.png",
            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 500,
        "next": ["ClickRewardCardConfirm"]
    },

    "MirrorRewardCardSelectCost": {
        "doc": "选择含经费（Cost）的奖励卡",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/get_reward_card/gain_cost.png",
            "threshold": 0.78
