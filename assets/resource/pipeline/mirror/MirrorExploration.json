            "MirrorEgoGiftPickSinking",
            "MirrorEgoGiftPickCharge",
            "MirrorEgoGiftPickPoise",
            "MirrorEgoGiftPickBurn",
            "MirrorEgoGiftPickFirst"
        ]
    },

