    "MirrorHandleShop": {
        "doc": "检测到商店界面",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/road_in_mir/shop.png",
            "threshold": 0.75
        },
        "action": "DoNothing",
        "next": [
            "MirrorShopHealAll",
            "MirrorLeaveShop"
        ]
    },

    "MirrorShopHealAll": {
        "doc": "进店自动点击全员治疗（由 MirrorShopStrategy option 决定是否启用）",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/shop/heal_sinner/heal_all_sinner_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 800,
        "next": [
            "MirrorShopHealReturn",
            "MirrorLeaveShop"
        ]
    },

    "MirrorShopHealReturn": {
        "doc": "治疗后点击返回商店主界面",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/shop/heal_sinner/heal_sinner_return_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 600,
        "next": ["MirrorLeaveShop"]
    },

    "MirrorLeaveShop": {
        "doc": "点击离开商店按钮",
        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/leave_shop_confirm.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000,
        "next": ["MirrorDungeonExploration"]
    },

