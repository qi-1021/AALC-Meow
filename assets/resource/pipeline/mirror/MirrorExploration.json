        "action": {
            "type": "Click",
            "target": [400, 540]
        },
        "post_delay": 600,
        "next": ["MirrorHandleEgoGiftBox"]
    },

    "MirrorHandleEgoGiftBox": {
        "doc": "饰品选择后出现「接受/拒绝」弹窗，默认接受",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/acquire_ego_gift_box_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 800,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorEgoGiftGetConfirm2": {
        "doc": "确认获得 EGO 饰品弹窗",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/ego_gift_get_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 600,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorHandleShop": {
        "doc": "检测到商店界面，直接离开商店",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/shop.png",
            "threshold": 0.75
        },
        "action": "DoNothing",
        "next": [
            "MirrorLeaveShop"
        ]
    },

    "MirrorLeaveShop": {
        "doc": "点击离开商店",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/leave_shop_confirm.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorHandleEvent": {
        "doc": "检测到镜牢事件界面，转交 EventHandling 处理",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/event.png",
            "threshold": 0.72
        },
        "action": "DoNothing",
        "next": [
            "EventHandling",
            "MirrorDungeonExploration"
        ]
    },

    "ClaimMirrorReward": {
        "doc": "镜牢结束，点击领取奖励",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/claim_reward/claim_rewards_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1200,
        "next": [
            "UseEnkephalinConfirm",
            "MirrorRewardsAcquiredConfirm"
        ]
    },

    "UseEnkephalinConfirm": {
        "doc": "使用脑啡肽续命确认",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/use_enkephalin.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1500,
        "next": ["MirrorDungeonExploration"]
    },

    "MirrorRewardsAcquiredConfirm": {
        "doc": "奖励已领取确认按钮，任务完成",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/claim_reward/rewards_acquired_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000
    }
}
