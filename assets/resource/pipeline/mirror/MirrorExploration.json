        "recognition": {
            "type": "TemplateMatch",
            "template": "mirror/claim_reward/claim_rewards_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1200,
        "next": [
            "MirrorCheckWeeklyBonuses",
            "UseEnkephalinConfirm",
            "MirrorRewardsAcquiredConfirm"
        ]
    },

    "MirrorCheckWeeklyBonuses": {
