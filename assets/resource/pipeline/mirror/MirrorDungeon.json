    "MirrorPickInitGiftsFirstThree": {
        "doc": "点击前3个初始藏品并确认",
        "action": {
            "type": "Click",
            "target": [
                400,
                450
            ]
        },
        "post_delay": 400,
        "next": [
            "MirrorConfirmInitGifts"
        ]
    },
