    "MirrorAcquireEgoGiftCard": {
        "doc": "遇到饰品卡选择界面：按 MirrorTheme option 选对应体系饰品，默认选第一个（最左）",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/acquire_ego_gift_card.png",
            "threshold": 0.75
        },
        "action": "DoNothing",
        "next": [
            "MirrorPickEgoGiftBleed",
            "MirrorPickEgoGiftFirst"
        ]
    },
    "MirrorPickEgoGiftBleed": {
        "doc": "选择流血体系饰品（被 MirrorTheme=bleed 时通过 pipeline_override 激活）",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/acquire_ego_gift/bleed.png",
            "threshold": 0.78
        },
        "action": "Click",
        "post_delay": 800,
        "next": [
            "MirrorRefuseOrConfirmGift"
        ]
    },
    "MirrorPickEgoGiftFirst": {
        "doc": "无匹配体系时，直接点击第一个饰品（屏幕固定坐标，通用 fallback）",
        "action": {
            "type": "Click",
            "target": [
                650,
                540
            ]
        },
        "post_delay": 800,
        "next": [
            "MirrorRefuseOrConfirmGift"
        ]
    },
    "MirrorRefuseOrConfirmGift": {
        "doc": "弹出拒绝/接受饰品确认时，点击接受",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_in_mir/acquire_ego_gift_box_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 600,
        "next": [
            "MirrorInDungeon"
        ]
    },
    "MirrorClaimReward": {
        "doc": "识别到镜牢奖励领取界面，点击领取",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/claim_reward/claim_rewards_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_delay": 1000,
        "next": [
