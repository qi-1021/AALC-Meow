{
    "MirrorDungeonEntry": {
        "doc": "从大厅点击进入镜牢（Drive 按钮）",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/home/drive.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_wait_freezes": 600,
        "next": [
            "MirrorClickEnter",
            "MirrorSelectTeamScreen",
            "MirrorCheckDreamingStar",
            "MirrorCheckInitEgoGift",
            "MirrorDungeonEntry"
        ]
    },
    "MirrorClickEnter": {
        "doc": "识别到「进入镜牢」按钮后点击",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_to_mir/enter_mirror_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_wait_freezes": 800,
        "next": [
            "MirrorQuickStart",
            "MirrorSelectTeamScreen",
            "MirrorCheckDreamingStar",
            "MirrorCheckInitEgoGift",
            "MirrorLevelConfirm"
        ]
    },
    "MirrorQuickStart": {
        "doc": "点击快速开始",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_to_mir/quick_start_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_wait_freezes": 1200,
        "next": [
            "MirrorSelectTeamScreen",
            "MirrorCheckDreamingStar",
            "MirrorCheckInitEgoGift",
            "MirrorLevelConfirm"
        ]
    },
    "MirrorSelectTeamScreen": {
        "doc": "检测到镜牢队伍选择界面（select_team_stars_assets）后，进入编队选择流程",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_to_mir/select_team_stars_assets.png",
            "threshold": 0.75
        },
        "action": "DoNothing",
        "post_delay": 500,
        "next": [
            "MirrorOpenTeamPanel",
            "MirrorClickConfirmTeamButton"
        ]
    },
    "MirrorOpenTeamPanel": {
        "doc": "点击「编队」按钮打开队伍列表面板",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/battle/teams.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_wait_freezes": 800,
        "next": [
            "MirrorSelectTeamByOCR",
            "MirrorOpenTeamPanel"
        ]
    },
    "MirrorSelectTeamByOCR": {
        "doc": "用 OCR 找到对应编队名称（如「编队#1」）并点击。编队号由 MirrorTeamPreset option 的 pipeline_override 注入。",
        "recognition": {
            "type": "OCR",
            "text": [
                "编队#1"
            ]
        },
        "action": "Click",
        "post_wait_freezes": 600,
        "next": [
            "MirrorClickConfirmTeamButton",
            "MirrorSelectTeamByOCR"
        ]
    },
    "MirrorClickConfirmTeamButton": {
        "doc": "点击队伍确认按钮（select_team_confirm_assets）完成队伍选定",
        "recognition": {
            "type": "TemplateMatch",
            "template": "image/mirror/road_to_mir/select_team_confirm_assets.png",
            "threshold": 0.75
        },
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "MirrorCheckDreamingStar",
            "MirrorCheckInitEgoGift",
            "TeamFormationStart",
            "MirrorLevelConfirm"
        ]
    },
