                {
                    "name": "rupture",
                    "label": "破裂",
                    "pipeline_override": {
                        "MirrorAcquireEgoGiftCard": {
                            "next": ["MirrorEgoGiftPickRupture", "MirrorEgoGiftPickFirst"]
