                "BattleSkillStrategy"
            ]
        },
        {
            "name": "MirrorDungeonQuick",
            "label": "镜牢快速开始挂机",
            "entry": "MirrorDungeonEntry",
            "description": "从大厅进入镜牢，点击快速开始、难度确认并衔接自动拼刀战斗",
