            "type": "switch",
            "label": "不跳过白棉花",
            "description": "遇到带有白棉花负面效果的事件或饰品时不主动跳过，按需收取",
            "default_case": "No",
            "cases": [
                { "name": "Yes", "label": "开启" },
                { "name": "No", "label": "关闭" }
            ]
        },
        "fight_to_last_man": {
            "type": "switch",
            "label": "战斗直到全灭",
