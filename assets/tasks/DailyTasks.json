                "MirrorRewardPreference"
            ]
        },
        {
            "name": "ClearTeamSelection",
            "label": "罪人编队快速清空",
            "entry": "ClearTeam",
            "description": "在编队界面一键清空当前出战的罪人席位"
        }
    ],
    "option": {
        "GamePackageName": {
            "type": "select",
            "label": "游戏包名/启动方式",
            "description": "选择边狱公司的安装来源或容器类型。若游戏已在后台运行则选最后一项",
            "default_case": "official",
            "cases": [
                {
                    "name": "official",
                    "label": "Google Play 官服 (com.ProjectMoon.LimbusCompany)",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.ProjectMoon.LimbusCompany"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "ourplay",
                    "label": "OurPlay 容器 (com.ourplay.limbuscompany)",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.ourplay.limbuscompany"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "already_running",
                    "label": "游戏已在后台运行，跳过启动",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "next": []
                        }
                    }
                }
            ]
        },
        "LuxcavationCombatCount": {
            "type": "select",
            "label": "连续战斗刷取次数",
            "description": "设置采光副本自动执行的连续战斗次数",
            "default_case": "1",
            "cases": [
                {
                    "name": "1",
                    "label": "单次作战 (1次)"
                },
                {
                    "name": "2",
                    "label": "连续作战 (2次)"
                },
                {
                    "name": "3",
                    "label": "连续作战 (3次)"
                },
                {
                    "name": "5",
                    "label": "连续作战 (5次)"
                }
            ]
        },
        "UseLunacyToEnkephalin": {
            "type": "switch",
            "label": "是否消耗狂气购买体力",
            "description": "开启后，若自然体力不足或设为狂气模式，将自动点击狂气补充",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是"
                },
                {
                    "name": "No",
                    "label": "否"
                }
            ]
        },
        "BattleSkillStrategy": {
            "type": "select",
            "label": "战斗技能策略",
            "description": "选择自动战斗时的技能使用策略，影响拼刀时的技能档位选择",
            "default_case": "win_rate",
            "cases": [
                {
                    "name": "win_rate",
                    "label": "胜率全选（自动选最高胜率档）"
                },
                {
                    "name": "avoid_3skill",
                    "label": "避免3技能（节省技能槽）"
                },
                {
                    "name": "first_round_def",
                    "label": "首回合全防御（降低首轮损耗）"
                }
            ]
        },
        "MirrorDifficulty": {
            "type": "select",
            "label": "镜牢难度",
            "description": "快速开始时选择镜牢的挑战难度",
            "default_case": "normal",
            "cases": [
                {
                    "name": "normal",
                    "label": "普通难度"
                },
                {
                    "name": "hard",
                    "label": "困难难度"
                }
            ]
        },
        "MirrorTheme": {
            "type": "select",
            "label": "镜牢主题/体系偏好",
            "description": "快速开始时选择镜牢的体系流派，无偏好则随机",
            "default_case": "none",
            "cases": [
                {
                    "name": "none",
                    "label": "无偏好（随机）"
                },
                {
                    "name": "bleed",
                    "label": "流血体系"
                },
                {
                    "name": "tremor",
                    "label": "震颤体系"
                },
                {
                    "name": "rupture",
                    "label": "破裂体系"
                },
                {
                    "name": "sinking",
                    "label": "沉沦体系"
                },
                {
                    "name": "charge",
                    "label": "充能体系"
                },
                {
                    "name": "poise",
                    "label": "呼吸体系"
                },
                {
                    "name": "burn",
                    "label": "燃烧体系"
                }
            ]
        },
        "MirrorRewardPreference": {
            "type": "select",
            "label": "镜牢奖励偏好",
            "description": "在镜牢探索结算时优先选取哪类奖励",
            "default_case": "ego_gift",
            "cases": [
                {
                    "name": "ego_gift",
                    "label": "优先取饰品（EGO礼物）"
                },
                {
                    "name": "ego_resource",
                    "label": "优先取自我资源"
                },
                {
                    "name": "any",
                    "label": "不偏好，自动取最左项"
                }
            ]
        }
    }
}
