        },
        {
            "name": "daily_task",
            "label": "日常本",
            "entry": "LuxcavationEntry",
            "description": "进行经验采光本与纽扣采光本的自动化刷取",
            "option": [
                "set_EXP_count",
                "set_thread_count",
                "daily_teams",
                "use_continuous_combat",
                "use_continuous_combat_select",
                "BattleSkillStrategy"
            ]
        },
        {
            "name": "mirror",
            "label": "自动镜牢",
            "entry": "MirrorDungeonEntry",
            "description": "进行自动镜牢探索、战斗、开局选星光与饰品、楼层卡包以及奖励结算",
            "option": [
                "set_mirror_count",
                "hard_mirror",
                "no_weekly_bonuses",
                "hard_mirror_single_bonuses",
                "save_rewards",
