                "infinite_dungeons",
                "select_event_pack",
                "skip_event_pack",
                "re_claim_rewards",
                "not_skip_whitegossypium",
                "fight_to_last_man",
                "daily_teams",
                "team_system",
                "shop_strategy",
                "reward_cards",
                "choose_opening_bonus",
                "opening_items",
                "avoid_skill_3",
                "defense_first_round",
                "sinner_selection"
            ]
        },
        {
            "name": "buy_enkephalin",
            "label": "自动购买体力",
            "entry": "EnkephalinModuleStart",
            "description": "狂气换体与脑啡肽模块转换",
            "option": [
                "set_lunacy_to_enkephalin",
                "Dr_Grandet_mode",
                "skip_enkephalin"
            ]
        },
        {
            "name": "get_reward",
            "label": "自动获取奖励",
            "entry": "PassPrizeStart",
            "description": "领取邮件和通行证日常与周常奖励",
            "option": [
                "set_get_prize"
            ]
        },
        {
            "name": "infinite_battle",
            "label": "无限战斗",
            "entry": "BattleAutoCombat",
            "description": "折射轨道与主线关卡无限胜率连线挂机战斗",
            "option": [
                "BattleSkillStrategy"
            ]
        },
        {
            "name": "StoryAutoSkip",
            "label": "剧情自动跳过",
            "entry": "StoryAutoSkip",
            "description": "在剧情播放过程中自动检测并点击右上角跳过按钮与二次确认"
        },
        {
            "name": "BackInitMenu",
            "label": "异常救援·返回大厅",
            "entry": "BackInitMenu",
            "description": "全局救援与状态回退：自动跳过剧情、投降逃离异常战斗、关闭公告弹窗并返回主界面大厅"
        }
    ],
    "option": {
        "game_package_name": {
            "type": "select",
            "label": "游戏包名/启动方式",
            "description": "选择边狱公司的安装来源或容器类型。若游戏已在后台运行则选最后一项",
            "default_case": "official",
            "cases": [
                {
                    "name": "official",
                    "label": "Google Play 官方包 (com.ProjectMoon.LimbusCompany)",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "action": { "type": "StartApp", "package": "com.ProjectMoon.LimbusCompany" }
                        }
                    }
                },
                {
                    "name": "ourplay",
                    "label": "OurPlay 容器版 (com.ourplay.limbuscompany)",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "action": { "type": "StartApp", "package": "com.ourplay.limbuscompany" }
                        }
                    }
                },
                {
                    "name": "skip",
                    "label": "跳过启动（游戏已在前台或手动开启）",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "action": "DoNothing",
                            "next": ["WaitLimbusHomeScreen", "StartGameSuccess"]
                        }
                    }
                }
            ]
        },
        "set_EXP_count": {
            "type": "select",
            "label": "经验本次数",
            "description": "设置日常刷取经验采光副本的连续战斗次数",
            "default_case": "1",
            "cases": [
                { "name": "0", "label": "0 次（不刷）" },
                { "name": "1", "label": "1 次" },
                { "name": "2", "label": "2 次" },
                { "name": "3", "label": "3 次" },
                { "name": "5", "label": "5 次" },
                { "name": "10", "label": "10 次" }
            ]
        },
        "set_thread_count": {
            "type": "select",
            "label": "纽本次数",
            "description": "设置日常刷取纽扣采光副本的连续战斗次数",
            "default_case": "3",
            "cases": [
                { "name": "0", "label": "0 次（不刷）" },
                { "name": "1", "label": "1 次" },
                { "name": "2", "label": "2 次" },
                { "name": "3", "label": "3 次（推荐每日打满）" },
                { "name": "5", "label": "5 次" },
                { "name": "10", "label": "10 次" }
            ]
        },
        "daily_teams": {
            "type": "select",
            "label": "使用编队",
            "description": "选择战斗与镜牢使用的队伍序号（需在游戏内提前预设保存）",
            "default_case": "1",
            "cases": [
                {
                    "name": "1",
                    "label": "Team1 (编队#1)",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#1"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "2",
                    "label": "Team2 (编队#2)",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#2"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "3",
                    "label": "Team3 (编队#3)",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#3"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "4",
                    "label": "Team4 (编队#4)",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#4"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "5",
                    "label": "Team5 (编队#5)",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#5"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                }
            ]
        },
        "use_continuous_combat": {
            "type": "switch",
            "label": "是否使用连续作战",
            "description": "开启后将在采光本结算时自动点击连续作战继续下一场",
            "default_case": "No",
            "cases": [
                { "name": "Yes", "label": "开启" },
                { "name": "No", "label": "关闭" }
            ]
        },
        "use_continuous_combat_select": {
            "type": "select",
            "label": "一场连续作战的最大次数",
            "description": "连续作战设定的单轮上限次数",
            "default_case": "3",
            "cases": [
                { "name": "1", "label": "1 Times" },
                { "name": "2", "label": "2 Times" },
                { "name": "3", "label": "3 Times" },
                { "name": "5", "label": "5 Times" },
                { "name": "10", "label": "10 Times" }
            ]
        },
        "set_mirror_count": {
            "type": "select",
            "label": "坐牢次数",
            "description": "设置执行镜牢副本的轮次数量",
            "default_case": "1",
            "cases": [
                { "name": "1", "label": "1 次" },
                { "name": "2", "label": "2 次" },
                { "name": "3", "label": "3 次" },
                { "name": "5", "label": "5 次" },
                { "name": "10", "label": "10 次" }
            ]
        },
        "hard_mirror": {
            "type": "select",
            "label": "使用困难镜牢",
            "description": "选择镜牢难度级别（普通难度 / 困难难度）",
            "default_case": "normal",
            "cases": [
                { "name": "normal", "label": "普通镜牢" },
                { "name": "hard", "label": "使用困难镜牢" }
            ]
        },
        "no_weekly_bonuses": {
            "type": "switch",
            "label": "不使用每周加成",
            "description": "结算时不消耗每周 3 次的狂气高倍加成，留存次数",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "不使用每周加成",
                    "pipeline_override": {
                        "MirrorCheckWeeklyBonuses": {
                            "next": ["MirrorRewardsAcquiredConfirm"]
                        }
                    }
                },
                { "name": "No", "label": "使用每周加成" }
            ]
        },
        "hard_mirror_single_bonuses": {
            "type": "switch",
            "label": "困牢单次加成",
            "description": "困难镜牢结算时仅使用单次加成，保留剩余次数给周常",
            "default_case": "No",
            "cases": [
                { "name": "Yes", "label": "开启单次加成" },
                { "name": "No", "label": "关闭" }
            ]
        },
        "save_rewards": {
            "type": "switch",
            "label": "保存困牢奖励",
            "description": "仅在困难镜牢时生效，打完通关后暂不领取奖励，保存在结算页",
            "default_case": "No",
            "cases": [
                { "name": "Yes", "label": "保存奖励" },
                { "name": "No", "label": "直接领取" }
            ]
        },
        "floor_3_exit": {
            "type": "switch",
            "label": "只打三层",
            "description": "开启后，镜牢进入第4层时自动点击设置->放弃并领取前3层奖励（通行证狂气最高性价比刷法）",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启（只打三层退牢）",
                    "pipeline_override": {
                        "MirrorDungeonExploration": {
                            "next": [
                                "MirrorFloor3ExitAction",
                                "ClickEnterNode",
                                "ClaimMirrorReward",
                                "MirrorDungeonExploration"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭（打满全层）",
                    "pipeline_override": {
                        "MirrorFloor3ExitAction": {
                            "next": ["ClickEnterNode"]
                        }
                    }
                }
            ]
        },
        "infinite_dungeons": {
            "type": "switch",
            "label": "无限坐牢",
            "description": "循环不断刷镜牢，不限次数，直至体力或脑啡肽耗尽",
            "default_case": "No",
            "cases": [
                { "name": "Yes", "label": "无限坐牢" },
                { "name": "No", "label": "按次数执行" }
            ]
        },
        "select_event_pack": {
            "type": "switch",
