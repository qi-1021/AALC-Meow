                {
                    "name": "tremor",
                    "label": "震颤",
                    "pipeline_override": {
                        "MirrorAcquireEgoGiftCard": {
                            "next": ["MirrorEgoGiftPickTremor", "MirrorEgoGiftPickFirst"]
                        }
