{
    "task": [
        {
            "name": "StartGame",
            "label": "启动边狱公司",
            "entry": "StartLimbusCompany",
            "description": "在手机上自动启动边狱公司游戏，支持 Google Play 官服和 OurPlay 容器等不同包名",
            "option": [
                "GamePackageName"
            ]
        },
        {
            "name": "EnkephalinModule",
            "label": "体力全换脑啡肽模块",
            "entry": "EnkephalinModuleStart",
            "description": "自动在主界面点击体力槽，选择全部兑换并将体力转换为脑啡肽模块",
            "option": [
                "UseLunacyToEnkephalin"
            ]
        },
        {
            "name": "PassPrize",
            "label": "通行证日常与周常奖励",
            "entry": "PassPrizeStart",
            "description": "自动从大厅进入赛季通行证，自动领取日常及周常任务的所有经验金币"
        },
        {
            "name": "LuxcavationEXP",
            "label": "经验采光本自动刷取",
            "entry": "LuxcavationEntry",
            "description": "从大厅进入采光副本，自动选中最新等级经验本，自动拼刀战斗直至通关",
            "option": [
                "LuxcavationCombatCount",
                "BattleSkillStrategy",
                "TeamPresetNumber"
            ]
        },
        {
            "name": "LuxcavationThread",
            "label": "纽扣采光本自动刷取",
            "entry": "LuxcavationEntry",
            "description": "从大厅进入采光副本，自动选中纽扣采光本最高等级并自动胜率拼刀战斗",
            "option": [
                "LuxcavationCombatCount",
                "BattleSkillStrategy",
                "TeamPresetNumber"
            ]
        },
        {
            "name": "MirrorDungeonQuick",
            "label": "镜牢快速开始挂机",
            "entry": "MirrorDungeonEntry",
            "description": "从大厅进入镜牢，自动选择编队、选择罪人、确认难度并全程挂机战斗与探索",
            "option": [
                "MirrorTeamPreset",
                "SinnerSelection",
                "ChooseOpeningBonus",
                "ChooseOpeningItems",
                "MirrorDifficulty",
                "MirrorTheme",
                "BattleSkillStrategy"
            ]
        },
        {
            "name": "MailClaim",
            "label": "一键领取邮箱奖励",
            "entry": "MailStart",
            "description": "自动从大厅进入邮箱，点击全部领取并确认关闭"
        },
        {
            "name": "StoryAutoSkip",
            "label": "剧情自动跳过",
            "entry": "StoryAutoSkip",
            "description": "在剧情播放过程中自动检测并点击右上角跳过按钮与二次确认"
        },
        {
            "name": "BattleAutoCombat",
            "label": "战斗自动胜率连线",
            "entry": "BattleAutoCombat",
            "description": "在战斗界面自动点击P（胜率拼刀）并转动齿轮开始回合，直至战斗结算确认",
            "option": [
                "BattleSkillStrategy"
            ]
        },
        {
            "name": "BackInitMenu",
            "label": "异常救援·一键返回大厅",
            "entry": "BackInitMenu",
            "description": "全局救援与状态回退：自动跳过剧情、投降逃离异常战斗、关闭公告弹窗并返回主界面大厅"
        },
        {
            "name": "EventHandling",
            "label": "事件高成功率自动判定",
            "entry": "EventHandling",
            "description": "遇到镜牢/主线事件时，自动检测成功率最高的罪人进行判定与推进"
        },
        {
            "name": "MirrorExploration",
            "label": "镜牢推进与奖励结算",
            "entry": "MirrorDungeonExploration",
            "description": "镜牢内自动点击进入前进节点、确认获取奖励卡包、饰品箱判定与离开商店",
            "option": [
                "MirrorRewardPreference"
            ]
        },
        {
            "name": "ClearTeamSelection",
            "label": "罪人编队快速清空",
            "entry": "ClearTeam",
            "description": "在编队界面一键清空当前出战的罪人席位"
        }
    ],
    "option": {
        "GamePackageName": {
            "type": "select",
            "label": "游戏包名/启动方式",
            "description": "选择边狱公司的安装来源或容器类型。若游戏已在后台运行则选最后一项",
            "default_case": "official",
            "cases": [
                {
                    "name": "official",
                    "label": "Google Play 官服 (com.ProjectMoon.LimbusCompany)",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.ProjectMoon.LimbusCompany"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "ourplay",
                    "label": "OurPlay 容器 (com.ourplay.limbuscompany)",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.ourplay.limbuscompany"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "already_running",
                    "label": "游戏已在后台运行，跳过启动",
                    "pipeline_override": {
                        "StartLimbusCompany": {
                            "next": []
                        }
                    }
                }
            ]
        },
        "LuxcavationCombatCount": {
            "type": "select",
            "label": "连续战斗刷取次数",
            "description": "设置采光副本自动执行的连续战斗次数",
            "default_case": "1",
            "cases": [
                {
                    "name": "1",
                    "label": "单次作战 (1次)"
                },
                {
                    "name": "2",
                    "label": "连续作战 (2次)"
                },
                {
                    "name": "3",
                    "label": "连续作战 (3次)"
                },
                {
                    "name": "5",
                    "label": "连续作战 (5次)"
                }
            ]
        },
        "UseLunacyToEnkephalin": {
            "type": "switch",
            "label": "是否消耗狂气购买体力",
            "description": "开启后，若自然体力不足或设为狂气模式，将自动点击狂气补充",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是"
                },
                {
                    "name": "No",
                    "label": "否"
                }
            ]
        },
        "BattleSkillStrategy": {
            "type": "select",
            "label": "战斗技能策略",
            "description": "选择自动战斗时的技能使用策略，影响拼刀时的技能档位选择",
            "default_case": "win_rate",
            "cases": [
                {
                    "name": "win_rate",
                    "label": "胜率全选（自动选最高胜率档）"
                },
                {
                    "name": "avoid_3skill",
                    "label": "避免3技能（节省技能槽）"
                },
                {
                    "name": "first_round_def",
                    "label": "首回合全防御（降低首轮损耗）"
                }
            ]
        },
        "MirrorDifficulty": {
            "type": "select",
            "label": "镜牢难度",
            "description": "快速开始时选择镜牢的挑战难度",
            "default_case": "normal",
            "cases": [
                {
                    "name": "normal",
                    "label": "普通难度"
                },
                {
                    "name": "hard",
                    "label": "困难难度"
                }
            ]
        },
        "MirrorTheme": {
            "type": "select",
            "label": "镜牢主题/体系偏好",
            "description": "快速开始时选择镜牢的体系流派，无偏好则随机",
            "default_case": "none",
            "cases": [
                {
                    "name": "none",
                    "label": "无偏好（随机）"
                },
                {
                    "name": "bleed",
                    "label": "流血体系"
                },
                {
                    "name": "tremor",
                    "label": "震颤体系"
                },
                {
                    "name": "rupture",
                    "label": "破裂体系"
                },
                {
                    "name": "sinking",
                    "label": "沉沦体系"
                },
                {
                    "name": "charge",
                    "label": "充能体系"
                },
                {
                    "name": "poise",
                    "label": "呼吸体系"
                },
                {
                    "name": "burn",
                    "label": "燃烧体系"
                }
            ]
        },
        "MirrorRewardPreference": {
            "type": "select",
            "label": "镜牢奖励偏好",
            "description": "在镜牢探索结算时优先选取哪类奖励",
            "default_case": "ego_gift",
            "cases": [
                {
                    "name": "ego_gift",
                    "label": "优先取饰品（EGO礼物）"
                },
                {
                    "name": "ego_resource",
                    "label": "优先取自我资源"
                },
                {
                    "name": "any",
                    "label": "不偏好，自动取最左项"
                }
            ]
        },
        "MirrorTeamPreset": {
            "type": "select",
            "label": "镜牢使用的编队预设",
            "description": "选择进入镜牢时使用的编队编号（需在游戏内提前保存对应编队）",
            "default_case": "1",
            "cases": [
                {
                    "name": "1",
                    "label": "编队 #1",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#1"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "2",
                    "label": "编队 #2",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#2"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "3",
                    "label": "编队 #3",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#3"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "4",
                    "label": "编队 #4",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#4"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "5",
                    "label": "编队 #5",
                    "pipeline_override": {
                        "MirrorSelectTeamByOCR": {
                            "recognition": { "type": "OCR", "text": ["编队#5"], "roi": [0, 0, 500, 1080] },
                            "action": "Click"
                        }
                    }
                }
            ]
        },
        "TeamPresetNumber": {
            "type": "select",
            "label": "战斗使用的编队预设",
            "description": "采光本等战斗任务中使用的编队编号",
            "default_case": "1",
            "cases": [
                { "name": "1", "label": "编队 #1" },
                { "name": "2", "label": "编队 #2" },
                { "name": "3", "label": "编队 #3" },
                { "name": "4", "label": "编队 #4" },
                { "name": "5", "label": "编队 #5" }
            ]
        },
        "SinnerSelection": {
            "type": "select",
            "label": "罪人出战阵容",
            "description": "指定镜牢内战斗时自动选择哪些罪人上阵。选「全12人」会依次点击所有罪人头像。选「仅使用已保存编队」则跳过罪人逐个点击，直接沿用编队预设。",
            "default_case": "preset_only",
            "cases": [
                {
                    "name": "preset_only",
                    "label": "仅使用已保存编队预设（推荐）",
                    "pipeline_override": {
                        "TeamFormationStart": {
                            "next": ["TeamFormationConfirm"]
                        }
                    }
                },
                {
                    "name": "all12",
                    "label": "自动选全12名罪人（按模板匹配）"
                }
            ]
        },
        "ChooseOpeningBonus": {
            "type": "switch",
            "label": "自选开局星光增益",
            "description": "进入镜牢时是否自动点选星光加成buff并确定",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是（自动确认星光）"
                },
                {
                    "name": "No",
                    "label": "否（跳过星光选择）",
                    "pipeline_override": {
                        "MirrorCheckDreamingStar": {
                            "next": ["MirrorCheckInitEgoGift", "TeamFormationStart", "MirrorLevelConfirm"]
                        }
                    }
                }
            ]
        },
        "ChooseOpeningItems": {
            "type": "switch",
            "label": "自选开局初始3饰品",
            "description": "开局藏品搜索界面是否自动根据所选体系选定前3件饰品并确认",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是（自动选定初始3饰品）"
                },
                {
                    "name": "No",
                    "label": "否（跳过初始饰品自选）",
                    "pipeline_override": {
                        "MirrorCheckInitEgoGift": {
                            "next": ["TeamFormationStart", "MirrorLevelConfirm", "MirrorInDungeon"]
                        }
                    }
                }
            ]
        }
    }
}

